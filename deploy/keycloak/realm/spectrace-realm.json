{
  "realm": "spectrace",
  "enabled": true,
  "displayName": "SpecTrace-CN (local demo realm)",
  "sslRequired": "external",
  "registrationAllowed": false,
  "registrationEmailAsUsername": false,
  "rememberMe": false,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 2592000,
  "attributes": {
    "spectrace.deployment.tier": "local-demo",
    "spectrace.realm.source": "deploy/keycloak/realm/spectrace-realm.json",
    "spectrace.realm.claims.contract": "org_id, org_type, roles and aud in the access token",
    "spectrace.identity.audience": "spectrace-api",
    "spectrace.identity.issuer.local": "http://localhost:8080/auth/realms/spectrace",
    "spectrace.identity.issuer.note": "The issuer is the externally visible Keycloak URL, so the gateway can front the IdP on /auth. Keycloak must run with KC_HTTP_RELATIVE_PATH=/auth and KC_HOSTNAME set to the external origin; the value above is the local development origin. Staging uses the ALB hostname, which M5 supplies."
  },
  "roles": {
    "realm": [
      {
        "name": "LABEL_OFFICER",
        "description": "Creates labels, validates structured declarations and submits for review. Permissions: LABEL.CREATE, LABEL.VALIDATE, LABEL.SUBMIT_REVIEW."
      },
      {
        "name": "APPROVER",
        "description": "Approves, rejects or requests changes on pending labels. Permissions: LABEL.APPROVE, LABEL.REQUEST_CHANGES, LABEL.REJECT."
      },
      {
        "name": "PUBLISHER",
        "description": "Publishes approved labels. Permissions: LABEL.PUBLISH."
      },
      {
        "name": "AUDITOR",
        "description": "Reads audit and validation evidence. Permissions: AUDIT.READ."
      },
      {
        "name": "ADMIN_DATA_MAINTENANCE",
        "description": "Maintains supplier, formula and rule fixture data. Permissions: FORMULA.RELEASE, RULE_SET.MAINTAIN, DATA.MAINTAIN."
      },
      {
        "name": "CHANGE_MANAGER",
        "description": "Creates change requests and launches impact analysis. Permissions: CHANGE_REQUEST.CREATE, IMPACT.RUN."
      }
    ]
  },
  "clientScopes": [
    {
      "name": "spectrace-identity-claims",
      "description": "BR-11 organisation claims (org_id, org_type) and the effective realm roles for SpecTrace clients. Values come from trusted single-valued user attributes and role assignments only; no request parameter can set them.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false",
        "consent.screen.text": ""
      },
      "protocolMappers": [
        {
          "name": "subject",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "org_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "org_id",
            "claim.name": "org_id",
            "jsonType.label": "String",
            "multivalued": "false",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "org_type",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "org_type",
            "claim.name": "org_type",
            "jsonType.label": "String",
            "multivalued": "false",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "spectrace-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "spectrace-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "realm_access.roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "preferred_username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "multivalued": "false",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "spectrace-web",
      "name": "SpecTrace web reference client",
      "description": "Public browser client: authorisation code flow with PKCE S256 only; implicit flow, direct access grants and service accounts disabled; no client secret. Local development redirect URIs only. See deploy/keycloak/README.md.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": false,
      "fullScopeAllowed": true,
      "frontchannelLogout": true,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*##http://127.0.0.1:5173/*",
        "backchannel.logout.session.required": "true",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false",
        "display.on.consent.screen": "false"
      },
      "defaultClientScopes": [
        "spectrace-identity-claims"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "spectrace-partner",
      "name": "SpecTrace partner client (onboarding pending)",
      "description": "Confidential client for the reviewed partner onboarding (G3): client credentials only, no realm role or organisation binding yet, so it fails closed. The secret is generated at import and injected at deploy time, never committed.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "consentRequired": false,
      "fullScopeAllowed": false,
      "frontchannelLogout": false,
      "redirectUris": [],
      "webOrigins": [],
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false",
        "display.on.consent.screen": "false"
      },
      "defaultClientScopes": [],
      "optionalClientScopes": []
    }
  ],
