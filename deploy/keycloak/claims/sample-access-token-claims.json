      "org_id": "org-supplier-alpha",
      "org_type": "SUPPLIER",
      "business_roles": [
        "ADMIN_DATA_MAINTENANCE",
        "LABEL_OFFICER"
      ],
      "access_token": {
        "iss": "http://localhost:8180/auth/realms/spectrace",
        "aud": [
          "spectrace-api"
        ],
        "typ": "Bearer",
        "azp": "spectrace-web",
        "org_id": "org-supplier-alpha",
        "org_type": "SUPPLIER",
        "roles": [
          "ADMIN_DATA_MAINTENANCE",
          "LABEL_OFFICER"
        ],
