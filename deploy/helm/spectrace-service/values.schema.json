{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "serviceName",
    "replicaCount",
    "image",
    "imagePullSecrets",
    "containerPort",
    "service",
    "resources",
    "nodeSelector",
    "tolerations",
    "spread",
    "autoscaling",
    "probes",
    "terminationGracePeriodSeconds",
    "env",
    "envFrom",
    "networkPolicy"
  ],
  "properties": {
    "serviceName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "maxLength": 40
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "image": {
      "type": "object",
      "required": [
        "repository",
        "tag",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "containerPort": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "service": {
      "type": "object",
      "required": [
        "port"
      ],
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "resources": {
      "type": "object",
      "required": [
        "requests",
        "limits"
      ],
      "properties": {
        "requests": {
          "type": "object",
          "required": [
            "cpu",
            "memory"
          ],
          "properties": {
            "cpu": {
              "type": "string",
              "minLength": 1
            },
            "memory": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "limits": {
          "type": "object",
          "required": [
            "cpu",
            "memory"
          ],
          "properties": {
            "cpu": {
              "type": "string",
              "minLength": 1
            },
            "memory": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "nodeSelector": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "spread": {
      "type": "object",
      "required": [
        "enabled",
        "minimumZones"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minimumZones": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "required": [
        "enabled",
        "minReplicas",
        "maxReplicas",
        "targetCPUUtilizationPercentage"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "targetCPUUtilizationPercentage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "probes": {
      "type": "object",
      "required": [
        "readinessPath",
        "livenessPath",
        "startupFailureThreshold"
      ],
      "properties": {
        "readinessPath": {
          "type": "string",
          "minLength": 1
        },
        "livenessPath": {
          "type": "string",
          "minLength": 1
        },
        "startupFailureThreshold": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "env": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "envFrom": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "networkPolicy": {
      "type": "object",
      "required": [
        "enabled",
        "ingressFromServices",
        "allowDNS",
        "egressRules"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "allowDNS": {
          "type": "boolean"
        },
        "ingressFromServices": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "egressRules": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "serviceName": {
            "const": "compliance"
          }
        }
      },
      "then": {
        "properties": {
          "resources": {
            "properties": {
              "requests": {
                "properties": {
                  "cpu": {
                    "const": "1"
                  },
                  "memory": {
                    "const": "2Gi"
                  }
                }
              },
              "limits": {
                "properties": {
                  "cpu": {
                    "const": "1"
                  },
                  "memory": {
                    "const": "2Gi"
                  }
                }
              }
            }
          },
          "nodeSelector": {
            "const": {
              "eks.amazonaws.com/nodegroup": "compliance",
              "node.kubernetes.io/instance-type": "c6i.large"
            }
          },
          "tolerations": {
            "contains": {
              "properties": {
                "key": {
                  "const": "dedicated"
                },
                "operator": {
                  "const": "Equal"
                },
                "value": {
                  "const": "compliance"
                },
                "effect": {
                  "const": "NoSchedule"
                }
              },
              "required": [
                "key",
                "operator",
                "value",
                "effect"
              ]
            }
          },
          "spread": {
            "properties": {
              "enabled": {
                "const": true
              },
              "minimumZones": {
                "const": 2
              }
            }
          },
          "networkPolicy": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "autoscaling": {
            "properties": {
              "minReplicas": {
                "const": 1
              },
              "maxReplicas": {
                "const": 4
              },
              "targetCPUUtilizationPercentage": {
                "const": 60
              }
            }
          }
        }
      }
    }
  ]
}
