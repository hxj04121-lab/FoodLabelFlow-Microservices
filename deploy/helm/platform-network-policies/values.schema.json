{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["namespaces", "operatorNamespaces", "cidrs"],
  "properties": {
    "namespaces": {
      "type": "object",
      "required": ["gateway", "keycloak", "rabbitmq", "observability", "specification", "formulation", "compliance", "label-workflow"],
      "properties": {
        "gateway": {"type": "string", "minLength": 1},
        "keycloak": {"type": "string", "minLength": 1},
        "rabbitmq": {"type": "string", "minLength": 1},
        "observability": {"type": "string", "minLength": 1},
        "specification": {"type": "string", "minLength": 1},
        "formulation": {"type": "string", "minLength": 1},
        "compliance": {"type": "string", "minLength": 1},
        "label-workflow": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "operatorNamespaces": {
      "type": "object",
      "required": ["rabbitmq", "keycloak"],
      "properties": {
        "rabbitmq": {"type": "string", "minLength": 1},
        "keycloak": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "cidrs": {
      "type": "object",
      "required": ["vpc", "alb", "nodes", "database"],
      "properties": {
        "vpc": {"type": "string", "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/([0-9]|[12][0-9]|3[0-2])$"},
        "alb": {"type": "array", "minItems": 2, "items": {"type": "string", "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/([0-9]|[12][0-9]|3[0-2])$"}},
        "nodes": {"type": "array", "minItems": 2, "items": {"type": "string", "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/([0-9]|[12][0-9]|3[0-2])$"}},
        "database": {"type": "array", "minItems": 2, "items": {"type": "string", "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/([0-9]|[12][0-9]|3[0-2])$"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
