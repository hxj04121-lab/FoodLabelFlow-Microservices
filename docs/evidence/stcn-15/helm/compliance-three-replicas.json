[
  {
    "apiVersion": "networking.k8s.io/v1",
    "kind": "NetworkPolicy",
    "metadata": {
      "name": "review-compliance",
      "labels": {
        "app.kubernetes.io/name": "compliance",
        "app.kubernetes.io/instance": "review",
        "app.kubernetes.io/managed-by": "Helm",
        "helm.sh/chart": "spectrace-service-0.1.0"
      }
    },
    "spec": {
      "podSelector": {
        "matchLabels": {
          "app.kubernetes.io/name": "compliance",
          "app.kubernetes.io/instance": "review"
        }
      },
      "policyTypes": [
        "Ingress",
        "Egress"
      ],
      "ingress": [
        {
          "from": [
            {
              "podSelector": {
                "matchLabels": {
                  "app.kubernetes.io/name": "gateway"
                }
              }
            }
          ],
          "ports": [
            {
              "port": "http",
              "protocol": "TCP"
            }
          ]
        },
        {
          "from": [
            {
              "podSelector": {
                "matchLabels": {
                  "app.kubernetes.io/name": "label-workflow"
                }
              }
            }
          ],
          "ports": [
            {
              "port": "http",
              "protocol": "TCP"
            }
          ]
        },
        {
          "from": [
            {
              "namespaceSelector": {
                "matchLabels": {
                  "kubernetes.io/metadata.name": "gateway"
                }
              },
              "podSelector": {
                "matchLabels": {
                  "app.kubernetes.io/name": "gateway"
                }
              }
            }
          ],
          "ports": [
            {
              "port": "http",
              "protocol": "TCP"
            }
          ]
        },
        {
          "from": [
            {
              "namespaceSelector": {
                "matchLabels": {
                  "kubernetes.io/metadata.name": "label-workflow"
                }
              },
              "podSelector": {
                "matchLabels": {
                  "app.kubernetes.io/name": "label-workflow"
                }
              }
            }
          ],
          "ports": [
            {
              "port": "http",
              "protocol": "TCP"
            }
          ]
        },
        {
          "from": [
            {
              "namespaceSelector": {
                "matchLabels": {
                  "kubernetes.io/metadata.name": "observability"
                }
              },
              "podSelector": {
                "matchLabels": {
                  "app.kubernetes.io/name": "grafana-alloy"
                }
              }
            }
          ],
          "ports": [
            {
              "port": "http",
              "protocol": "TCP"
            }
          ]
        }
      ],
      "egress": [
        {
          "to": [
            {
              "namespaceSelector": {
                "matchLabels": {
                  "kubernetes.io/metadata.name": "kube-system"
                }
              },
              "podSelector": {
                "matchLabels": {
                  "k8s-app": "kube-dns"
                }
              }
            }
          ],
          "ports": [
            {
              "port": 53,
              "protocol": "UDP"
            },
            {
              "port": 53,
              "protocol": "TCP"
            }
          ]
        },
        {
          "ports": [
            {
              "port": 5672,
              "protocol": "TCP"
            }
          ],
          "to": [
            {
              "namespaceSelector": {
                "matchLabels": {
                  "kubernetes.io/metadata.name": "rabbitmq"
                }
              },
              "podSelector": {
                "matchLabels": {
                  "app.kubernetes.io/name": "rabbitmq"
                }
              }
            }
          ]
        }
      ]
    }
  },
  {
    "apiVersion": "v1",
    "kind": "ServiceAccount",
    "metadata": {
      "name": "review-compliance",
      "labels": {
        "app.kubernetes.io/name": "compliance",
        "app.kubernetes.io/instance": "review",
        "app.kubernetes.io/managed-by": "Helm",
        "helm.sh/chart": "spectrace-service-0.1.0"
      }
    },
    "automountServiceAccountToken": false
  },
  {
    "apiVersion": "v1",
    "kind": "Service",
    "metadata": {
      "name": "review-compliance",
      "labels": {
        "app.kubernetes.io/name": "compliance",
        "app.kubernetes.io/instance": "review",
        "app.kubernetes.io/managed-by": "Helm",
        "helm.sh/chart": "spectrace-service-0.1.0"
      }
    },
    "spec": {
      "type": "ClusterIP",
      "selector": {
        "app.kubernetes.io/name": "compliance",
        "app.kubernetes.io/instance": "review"
      },
      "ports": [
        {
          "name": "http",
          "port": 8080,
          "targetPort": "http",
          "protocol": "TCP"
        }
      ]
    }
  },
  {
    "apiVersion": "apps/v1",
    "kind": "Deployment",
    "metadata": {
      "name": "review-compliance",
      "labels": {
        "app.kubernetes.io/name": "compliance",
        "app.kubernetes.io/instance": "review",
        "app.kubernetes.io/managed-by": "Helm",
        "helm.sh/chart": "spectrace-service-0.1.0"
      }
    },
    "spec": {
      "replicas": 3,
      "strategy": {
        "type": "RollingUpdate",
        "rollingUpdate": {
          "maxSurge": 1,
          "maxUnavailable": 0
        }
      },
      "selector": {
        "matchLabels": {
          "app.kubernetes.io/name": "compliance",
          "app.kubernetes.io/instance": "review"
        }
      },
      "template": {
        "metadata": {
          "labels": {
            "app.kubernetes.io/name": "compliance",
            "app.kubernetes.io/instance": "review"
          }
        },
        "spec": {
          "serviceAccountName": "review-compliance",
          "automountServiceAccountToken": false,
          "terminationGracePeriodSeconds": 30,
          "securityContext": {
            "runAsNonRoot": true,
            "runAsUser": 10001,
            "runAsGroup": 10001,
            "fsGroup": 10001,
            "seccompProfile": {
              "type": "RuntimeDefault"
            }
          },
          "nodeSelector": {
            "eks.amazonaws.com/nodegroup": "compliance",
            "node.kubernetes.io/instance-type": "c6i.large"
          },
          "tolerations": [
            {
              "effect": "NoSchedule",
              "key": "dedicated",
              "operator": "Equal",
              "value": "compliance"
            }
          ],
          "topologySpreadConstraints": [
            {
              "maxSkew": 1,
              "minDomains": 2,
              "topologyKey": "topology.kubernetes.io/zone",
              "whenUnsatisfiable": "DoNotSchedule",
              "nodeAffinityPolicy": "Honor",
              "nodeTaintsPolicy": "Honor",
              "labelSelector": {
                "matchLabels": {
                  "app.kubernetes.io/name": "compliance",
                  "app.kubernetes.io/instance": "review"
                }
              }
            },
            {
              "maxSkew": 1,
              "topologyKey": "kubernetes.io/hostname",
              "whenUnsatisfiable": "DoNotSchedule",
              "nodeAffinityPolicy": "Honor",
              "nodeTaintsPolicy": "Honor",
              "labelSelector": {
                "matchLabels": {
                  "app.kubernetes.io/name": "compliance",
                  "app.kubernetes.io/instance": "review"
                }
              }
            }
          ],
          "containers": [
            {
              "name": "compliance",
              "image": "example.invalid/spectrace/service:replace-with-commit-sha",
              "imagePullPolicy": "IfNotPresent",
              "ports": [
                {
                  "name": "http",
                  "containerPort": 8080,
                  "protocol": "TCP"
                }
              ],
              "securityContext": {
                "allowPrivilegeEscalation": false,
                "readOnlyRootFilesystem": true,
                "capabilities": {
                  "drop": [
                    "ALL"
                  ]
                }
              },
              "resources": {
                "limits": {
                  "cpu": "1",
                  "memory": "2Gi"
                },
                "requests": {
                  "cpu": "1",
                  "memory": "2Gi"
                }
              },
              "startupProbe": {
                "httpGet": {
                  "path": "/actuator/health/liveness",
                  "port": "http"
                },
                "periodSeconds": 5,
                "failureThreshold": 30
              },
              "readinessProbe": {
                "httpGet": {
                  "path": "/actuator/health/readiness",
                  "port": "http"
                },
                "periodSeconds": 5,
                "timeoutSeconds": 2,
                "failureThreshold": 3
              },
              "livenessProbe": {
                "httpGet": {
                  "path": "/actuator/health/liveness",
                  "port": "http"
                },
                "periodSeconds": 10,
                "timeoutSeconds": 2,
                "failureThreshold": 3
              },
              "envFrom": [
                {
                  "secretRef": {
                    "name": "compliance-runtime"
                  }
                }
              ],
              "volumeMounts": [
                {
                  "name": "tmp",
                  "mountPath": "/tmp"
                }
              ]
            }
          ],
          "volumes": [
            {
              "name": "tmp",
              "emptyDir": {}
            }
          ]
        }
      }
    }
  }
]
