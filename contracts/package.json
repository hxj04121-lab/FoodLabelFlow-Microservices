{
  "name": "spectrace-cn-g0-contracts",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "lint": "spectral lint openapi/compliance.v1.yaml --fail-severity warn",
    "test": "node test-contracts.mjs --scope events",
    "check": "npm run check:events",
    "check:events": "node test-contracts.mjs --scope events",
    "check:http": "npm run lint && node test-contracts.mjs --scope http",
    "check:envelope": "node test-envelope-interface.mjs",
    "lint:m1": "spectral lint openapi/specification.v1.yaml openapi/formulation.v1.yaml --fail-severity warn",
    "check:m1": "npm run lint:m1 && node test-m1-contracts.mjs"
  },
  "devDependencies": {
    "@stoplight/spectral-cli": "6.16.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "yaml": "2.9.1"
  }
}
