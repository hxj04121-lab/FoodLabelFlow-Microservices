{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "label-published-v1.schema.json",
  "title": "LabelPublished.v1",
  "description": "Label Workflow profile composes the actual M1 canonical Envelope with the existing LabelPublished payload and a label-workflow-service producer. Pinned provider provenance is recorded in label-envelope-sources.v1.json; candidate adoption does not establish owner acceptance or a v1 freeze.",
  "allOf": [
    {
      "$ref": "event-envelope.v1.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "LabelPublished.v1"
        },
        "producer": {
          "const": "label-workflow-service"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "productId",
            "labelVersionId",
            "formulaVersionId",
            "ruleSetVersionId",
            "jurisdictionCode",
            "declarations"
          ],
          "properties": {
            "productId": {
              "type": "string",
              "minLength": 1
            },
            "labelVersionId": {
              "type": "string",
              "minLength": 1
            },
            "formulaVersionId": {
              "type": "string",
              "minLength": 1
            },
            "ruleSetVersionId": {
              "type": "string",
              "minLength": 1
            },
            "jurisdictionCode": {
              "type": "string",
              "minLength": 1
            },
            "declarations": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/AllergenDeclaration"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "AllergenDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allergenId",
        "declarationType",
        "declarationSource",
        "displayText"
      ],
      "properties": {
        "allergenId": {
          "type": "string",
          "minLength": 1
        },
        "declarationType": {
          "const": "CONTAINS"
        },
        "declarationSource": {
          "enum": [
            "MIGRATED_PUBLIC_LABEL",
            "FORMULA_DERIVED",
            "SYSTEM_PROPOSED",
            "USER_ENTERED"
          ]
        },
        "displayText": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
