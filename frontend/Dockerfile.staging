# Build context: frontend/ (not the repository root).
FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci --no-audit --no-fund
COPY . .
ARG VITE_OIDC_AUTHORITY
ARG VITE_OIDC_AUDIENCE=spectrace-api
ARG SOURCE_COMMIT
ENV VITE_AUTH_ENABLED=true \
    VITE_SITE_BASE=/ \
    VITE_GATEWAY_ORIGIN=/ \
    VITE_CALLER_CLAIMS_PATH=/api/specifications/caller-claims \
    VITE_OIDC_AUTHORITY=${VITE_OIDC_AUTHORITY} \
    VITE_OIDC_AUDIENCE=${VITE_OIDC_AUDIENCE} \
    GITHUB_SHA=${SOURCE_COMMIT}
RUN node scripts/check-pages-config.mjs && npm run build && node scripts/write-pages-release.mjs

FROM nginxinc/nginx-unprivileged:1.29-alpine
ARG SOURCE_COMMIT
LABEL org.opencontainers.image.source="https://github.com/hxj04121-lab/FoodLabelFlow-Microservices" \
      org.opencontainers.image.revision="${SOURCE_COMMIT}"
COPY nginx.staging.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
RUN nginx -t
EXPOSE 8080
