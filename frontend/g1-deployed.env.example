VITE_OIDC_AUDIENCE=spectrace-api
VITE_CALLER_CLAIMS_PATH=/api/specifications/caller-claims
M3_DEPLOYED_BASE_URL=https://hxj04121-lab.github.io/FoodLabelFlow-Microservices/
# M5 supplies actual browser-reachable HTTPS values; no placeholder deployment.
VITE_GATEWAY_ORIGIN=
