# Local G1 reference consumer. Copy to .env.local; no secrets belong in VITE_*.
VITE_AUTH_ENABLED=true
VITE_OIDC_AUTHORITY=http://localhost:8080/auth/realms/spectrace
VITE_OIDC_AUDIENCE=spectrace-api
VITE_GATEWAY_ORIGIN=http://localhost:8080
VITE_SITE_BASE=/
# Set only after M4 confirms the public route and caller DTO; no production endpoint is assumed.
VITE_CALLER_CLAIMS_PATH=
